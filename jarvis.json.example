{
  "name": "Jarvis",
  "agent_dir": "~/.local/share/my-agent",
  "provider": "openai",
  "model": "gpt-4.1-mini",
  "fallback_model": "gpt-4.1-nano",
  "reasoning_provider": "openai",
  "stt_provider": "local",
  "tts_provider": "local",
  "openai_base_url": "https://api.openai.com/v1",
  "max_output_tokens": 2048,
  "request_timeout_s": 60,
  "max_retries": 2,
  "max_tool_rounds": 8,
  "mic_mode": "ptt",
  "wake_word_enabled": false,
  "voice": "alloy",
  "speaking_speed": 1.0,
  "visualizer_theme": "board",
  "dashboard_enabled": true,
  "dashboard_port": 8795,
  "memory_dir": "",
  "memory_expire_days": 0,
  "approved_dirs": [],
  "computer_mode": "read_only",
  "web_search_enabled": false,
  "webcam_enabled": false,
  "gesture_controls": false,
  "monthly_budget_usd": 20.0,
  "daily_budget_usd": 5.0,
  "budget_warn_pct": 80,
  "permission_mode": "ask",
  "signals_dir": "",
  "greeting": "Hello, what are we working on today?"
}
