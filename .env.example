# Copy to .env and fill in. Never commit .env.
# OpenAI (ChatGPT) — required when provider=openai
OPENAI_API_KEY=sk-your-key-here

# Optional: ElevenLabs voice (also supported via OS keychain in backtalk)
# ELEVENLABS_API_KEY=

# Optional: override OpenAI-compatible base URL (Azure/proxy/local gateways)
# OPENAI_BASE_URL=https://api.openai.com/v1
